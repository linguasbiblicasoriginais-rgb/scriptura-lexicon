  "PSA": {
    "headings": {
      "3": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Δαυὶδ, ὁπότε ἀπεδίδρασκεν ἀπὸ προσώπου Ἀβεσσαλὼμ τοῦ υἱοῦ αὐτοῦ."
        }
      ],
      "4": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ἐν ψαλμοῖς ᾠδὴ τᾠ Δαυίδ."
        }
      ],
      "5": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τῆς κληρονομούσης, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "6": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ἐν ὕμνοις ὑπὲρ τῆς ὀγδόης, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "7": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Δαυὶδ, ὃν ᾖσε τῷ Κυρίῳ ὑπὲρ τῶν λόγων Χουσὶ υἱοῦ Ἰεμενεί."
        }
      ],
      "8": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τῶν ληνῶν, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "9": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τῶν κρυφίων τοῦ υἱοῦ, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "10": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυὶδ."
        }
      ],
      "11": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τῆς ὀγδόης, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "12": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "13": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "14": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "15": [
        {
          "type": "d",
          "text": "Στηλογραφία τῷ Δαυίδ."
        }
      ],
      "16": [
        {
          "type": "d",
          "text": "Προσευχὴ τοῦ Δαυίδ."
        }
      ],
      "17": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος τῷ παιδὶ Κυρίου τῷ Δαυὶδ, ἃ ἐλάλησε τῷ Κυρίῳ, τοὺς λόγους τῆς ᾠδῆς ταύτης, ἐν ἡμέρᾳ ᾗ ἐῤῥύσατο αὐτὸν Κύριος ἐκ χειρὸς πάντων τῶν ἐχθρῶν αὐτοῦ, καὶ ἐκ χειρὸς Σαοὺλ, καὶ εἶπεν,"
        }
      ],
      "18": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "19": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "20": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "21": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τῆς ἀντιλήψεως τῆς ἑωθινῆς, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "22": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "23": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Δαυὶδ τῆς μιᾶς σαββάτου."
        }
      ],
      "24": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "25": [
        {
          "type": "d",
          "text": "Τοῦ Δαυίδ."
        }
      ],
      "26": [
        {
          "type": "d",
          "text": "Τοῦ Δαυὶδ, πρὸ τοῦ χρισθῆναι."
        }
      ],
      "27": [
        {
          "type": "d",
          "text": "Τοῦ Δαυίδ."
        }
      ],
      "28": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Δαυὶδ ἐξοδίου σκηνῆς."
        }
      ],
      "29": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς ᾠδῆς τοῦ ἐνκαινισμοῦ τοῦ οἴκου τοῦ Δαυίδ."
        }
      ],
      "30": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυὶδ, ἐκστάσεως."
        }
      ],
      "31": [
        {
          "type": "d",
          "text": "Συνέσεως τῷ Δαυίδ."
        }
      ],
      "32": [
        {
          "type": "d",
          "text": "Τῷ Δαυίδ."
        }
      ],
      "33": [
        {
          "type": "d",
          "text": "Τῷ Δαυὶδ, ὁπότε ἠλλοίωσε τὸ πρόσωπον αὐτοῦ ἐναντίον Ἀβιμέλεχ, καὶ ἀπέλυσεν αὐτὸν, καὶ ἀπῆλθεν."
        }
      ],
      "34": [
        {
          "type": "d",
          "text": "Τῷ Δαυίδ."
        }
      ],
      "35": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, τῷ δούλῳ Κυρίου τῷ Δαυίδ."
        }
      ],
      "36": [
        {
          "type": "d",
          "text": "Τῷ Δαυίδ."
        }
      ],
      "37": [
        {
          "type": "d",
          "text": "Φαλμὸς τῷ Δαυὶδ εἰς ἀνάμνησιν περὶ σαββάτου."
        }
      ],
      "38": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, τῷ Ἰδιθοὺν ᾠδὴ τῷ Δαυίδ."
        }
      ],
      "39": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, τῷ Δαυὶδ ψαλμός."
        }
      ],
      "40": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "41": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, εἰς σύνεσιν τοῖς υἱοῖς Κορέ."
        }
      ],
      "42": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "43": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, τοῖς υἱοῖς Κορὲ εἰς σύνεσιν ψαλμός."
        }
      ],
      "44": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τῶν ἀλλοιωθησομένων τοῖς υἱοῖς Κορὲ εἰς σύνεσιν, ᾠδὴ ὑπὲρ τοῦ ἀγαπητοῦ."
        }
      ],
      "45": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τῶν υἱῶν Κορὲ, ὑπὲρ τῶν κρυφίων ψαλμός."
        }
      ],
      "46": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τῶν υἱῶν Κορὲ ψαλμός."
        }
      ],
      "47": [
        {
          "type": "d",
          "text": "Ψαλμὸς ᾠδῆς τοῖς υἱοῖς Κορὲ δευτέρᾳ σαββάτου."
        }
      ],
      "48": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, τοῖς υἱοῖς Κορὲ ψαλμός."
        }
      ],
      "49": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Ἀσάφ."
        }
      ],
      "50": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυὶδ,\n\nἐν τῷ ἐλθεῖν πρὸς αὐτὸν Νάθαν τὸν προφήτην, ἡνίκα εἰσῆλθε πρὸς Βηρσαβεέ."
        }
      ],
      "51": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος συνέσεως τῷ Δαυὶδ,\n\nἐν τῷ ἐλθεῖν Δωὴκ τὸν Ἰδουμαῖον, καὶ ἀναγγεῖλαι τῷ Σαοὺλ, καὶ εἰπεῖν αὐτῷ, ἦλθε Δαυὶδ εἰς τὸν οἶκον Ἀβιμέλεχ."
        }
      ],
      "52": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ μαελὲθ συνέσεως τῷ Δαυίδ."
        }
      ],
      "53": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ἐν ὕμνοις συνέσεως τῷ Δαυὶδ,\n\nἐν τῷ ἐλθεῖν τοὺς Ζειφαίους, καὶ εἰπεῖν τῷ Σαοὺλ, οὐκ ἰδοὺ Δαυὶδ κέκρυπται παρʼ ἡμῖν;"
        }
      ],
      "54": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ἐν ὕμνοις συνέσεως τῷ Δαυίδ."
        }
      ],
      "55": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τοῦ λαοῦ τοῦ ἀπὸ τῶν ἁγίων μεμακρυμμένου, τῷ Δαυὶδ εἰς στηλογραφίαν, ὁπότε ἐκράτησαν αὐτὸν οἱ ἀλλόφυλοι ἐν Γέθ."
        }
      ],
      "56": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, μὴ διαφθείρῃς, τῷ Δαυὶδ εἰς στηλογραφίαν, ἐν τῷ αὐτὸν ἀποδιδράσκειν ἀπὸ προσώπου Σαοὺλ εἰς τὸ σπήλαιον."
        }
      ],
      "57": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, μὴ διαφθείρῃς, τῷ Δαυὶδ εἰς στηλογραφίαν."
        }
      ],
      "58": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, μὴ διαφθείρῃς, τῷ Δαυὶδ εἰς στηλογραφίαν, ὁπότε ἀπέστειλε Σαοὺλ, καὶ ἐφύλαξε τὸν οἶκον αὐτοῦ τοῦ θανατῶσαι αὐτόν."
        }
      ],
      "59": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, τοῖς ἀλλοιωθησομένοις ἔτι, εἰς στηλογραφίαν τῷ Δαυὶδ εἰς διδαχὴν,\n\nὁπότε ἐνεπύρισε τὴν Μεσοποταμίαν Συρίας, καὶ τὴν Συρίαν Σοβὰλ, καὶ ἐπέστρεψεν Ἰωὰβ, καὶ ἐπάταξε τὴν φάραγγα τῶν ἁλῶν, δώδεκα χιλιάδας."
        }
      ],
      "60": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ἐν ὕμνοις τῷ Δαυίδ."
        }
      ],
      "61": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ Ἰδιθοὺν ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "62": [
        {
          "type": "d",
          "text": "Ψαλμὸς τῷ Δαυὶδ, ἐν τῷ εἶναι αὐτὸν ἐν τῇ ἐρήμῳ τῆς Ἰδουμαίας."
        }
      ],
      "63": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "64": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ψαλμὸς τῷ Δαυίδ, ᾠδή."
        }
      ],
      "65": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ᾠδὴ ψαλμοῦ ἀναστάσεως."
        }
      ],
      "66": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ἐν ὕμνοις ψαλμὸς τῷ Δαυίδ."
        }
      ],
      "67": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, τῷ Δαυὶδ ψαλμὸς ᾠδῆς."
        }
      ],
      "68": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, ὑπὲρ τῶν ἀλλοιωθησομένων, τῶ Δαυίδ."
        }
      ],
      "69": [
        {
          "type": "d",
          "text": "Εἰς τὸ τέλος, τῷ Δαυὶδ εἰς ἀνάμνησιν, εἰς τὸ σῶσαί με Κύριον."
        }
      ],
      "70": [
        {
          "type": "d",
          "text": "Τῷ Δαυὶδ υἱῶν Ἰωναδὰβ, καὶ τῶν πρώτων αἰχμαλωτισθέντων."
        }
      ],
      "71": [
        {
          "type": "d",
          "text": "Εἰς Σαλωμών."
