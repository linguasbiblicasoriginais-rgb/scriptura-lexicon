{
  "schema_version": 2,
  "project": "GDHAGP / Scriptura Lexicon",
  "stage": "PEREIRA",
  "branch": "chat-gpt-pereira",
  "checkpoint_authority": "remote GitHub lexical commits and canonical source-specific rules",
  "progress_policy": "recalculate on every run; never trust conversation state or a cached SHA",
  "source_pdf": null,
  "source_filename_stable": null,
